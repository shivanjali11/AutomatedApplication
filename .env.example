# --- Required ---
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/automailer
# Your Gmail address — the sender, whichever MAIL_PROVIDER you use
SMTP_USER=you@gmail.com
FROM_NAME=Shivanjali Kumari

# --- How mail is sent ---
# smtp      : Gmail SMTP + App Password. Simplest, but blocked on Render's free tier.
# gmail-api : Gmail API over HTTPS. Works on free hosts. Setup: README → Gmail API.
MAIL_PROVIDER=smtp

# smtp only — Gmail App Password (not your normal password): https://myaccount.google.com/apppasswords
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# gmail-api only — get the refresh token with `npm run gmail:auth`
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Contacts source ---
# Google Sheet shared as "Anyone with the link: Viewer". Falls back to CSV_PATH if unset or unreachable.
GOOGLE_SHEET_URL=
CSV_PATH=./data/hr_contacts.csv

# --- Scheduling & sending ---
CRON_SCHEDULE=0 10 * * 1-5
TIMEZONE=Asia/Kolkata
BATCH_SIZE=20
# Pause between emails, for spam safety
DELAY_MS=60000
MAX_ATTEMPTS=3
TEMPLATE_NAME=default

# Default file for `npm run resume:upload` when no path is given
RESUME_PATH=./resume/Shivanjali_Resume.pdf

# --- Health check (GET /health) — 0 disables ---
HEALTH_PORT=3000
BOT_HEALTH_PORT=3001

# --- Telegram bot (only needed for `npm run bot:telegram`) ---
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_CHAT_ID=
